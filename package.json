{
  "name": "token-monitor",
  "productName": "Token Monitor",
  "version": "0.83.0",
  "description": "Live token & cost widget for Claude Code, Codex & Hermes — local-first, optional multi-device sync.",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "npm run ensure:tokscale && electron .",
    "hub": "node src/hub/server.js",
    "agent": "npm run ensure:tokscale && node src/agent/agent.js",
    "agent:once": "npm run ensure:tokscale && node src/agent/agent.js --once",
    "widget": "npm run ensure:tokscale && electron .",
    "dev": "npm run ensure:tokscale && electron .",
    "ensure:tokscale": "node scripts/ensure-vendored-tokscale.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "c8 npm test",
    "build:windows-dock": "node scripts/build-windows-dock.js",
    "sync:worker": "node scripts/sync-worker-shared.js",
    "update:hub-build": "node scripts/update-hub-build.js && npm run sync:worker",
    "pack": "npm run ensure:tokscale && electron-builder --config scripts/electron-builder.config.js --dir",
    "dist:win": "npm run ensure:tokscale -- --platform=win32-x64 && electron-builder --win --x64 --publish never",
    "dist:win:dir": "npm run ensure:tokscale -- --platform=win32-x64 && electron-builder --win dir --x64 --publish never",
    "dist:win:prepackaged": "electron-builder --prepackaged dist/win-unpacked --win nsis portable --x64 --publish never",
    "dist:linux": "npm run ensure:tokscale -- --platform=linux-x64 && electron-builder --config scripts/electron-builder.config.js --linux --x64 --publish never",
    "verify:release-artifact-names": "node scripts/verify-updater-artifact-names.js dist",
    "benchmark:hub-bandwidth": "node scripts/benchmark-hub-bandwidth.js",
    "lint": "eslint .",
    "verify": "npm run lint && npm test"
  },
  "build": {
    "beforePack": "scripts/build-windows-dock.js",
    "appId": "com.javis.tokenmonitor",
    "productName": "Token Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/electron/**/*",
      "src/shared/**/*",
      "scripts/vendor/tokscale.json",
      "src/hub/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*",
      "node_modules/koffi/**/*"
    ],
    "win": {
      "extraResources": [
        {
          "from": "build/windows-dock/TokenMonitor.DockBackdrop.exe",
          "to": "windows-dock/TokenMonitor.DockBackdrop.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png",
      "files": [
        "assets/icon-win.png"
      ],
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "publisherName": "SignPath Foundation"
      }
    },
    "linux": {
      "artifactName": "Token-Monitor-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "synopsis": "Live token & cost widget for AI coding tools",
      "description": "Real-time token, cost, and AI limits widget with multi-device sync for Claude Code, Codex, OpenCode and more."
    },
    "nsis": {
      "artifactName": "Token-Monitor-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/nsis-installer.nsh"
    },
    "portable": {
      "artifactName": "Token-Monitor-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Javis603",
        "repo": "token-monitor"
      }
    ]
  },
  "keywords": [
    "tokscale",
    "claude-code",
    "codex",
    "hermes",
    "token-monitor",
    "token-usage",
    "cost-tracking",
    "llm",
    "ai-tools",
    "electron",
    "desktop-widget",
    "local-first",
    "self-hosted"
  ],
  "author": "Javis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javis603/token-monitor.git"
  },
  "homepage": "https://github.com/Javis603/token-monitor#readme",
  "bugs": {
    "url": "https://github.com/Javis603/token-monitor/issues"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "image-size": "^2.0.4",
    "koffi": "^3.3.5",
    "markdown-it": "^15.0.3",
    "semver": "^7.8.5",
    "tokscale": "^4.20.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/osx-sign": "1.3.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "eslint": "^10.13.0",
    "espree": "^11.2.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
