{
  "extends": "./vendor/t3/tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./vendor/t3/apps/web/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src"
  ]
}
